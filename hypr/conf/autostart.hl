exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

exec-once = sleep 1 && waybar
exec-once = sleep 1 && dunst
exec-once = sleep 1 && nm-applet --indicator
exec-once = sleep 1 && wl-paste --type text --watch cliphist store
exec-once = sleep 1 && wl-paste --type image --watch cliphist store
exec-once = sleep 1 && /usr/lib/polkit-kde-authentication-agent-1